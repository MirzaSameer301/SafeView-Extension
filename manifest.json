{
  "manifest_version": 3,
  "name": "SafeEyes",
  "version": "1.0.0",
  "description": "Block the kinds of content you don't want to see, protected by a password.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "SafeEyes"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/shared/categories.js",
        "src/shared/storage.js",
        "src/shared/filter.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}